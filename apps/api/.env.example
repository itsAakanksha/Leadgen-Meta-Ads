# Database. Locally both point at docker-compose Postgres.
# On Supabase: DATABASE_URL = session pooler URL, DIRECT_URL = direct connection (migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lead_intake
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/lead_intake
# Separate database for integration tests (created by docker/postgres/init.sql).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lead_intake_test
