# Database: Supabase. Use the "Session pooler" connection string (port 5432) for both.
# Percent-encode special characters in the password (e.g. a space becomes %20).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Integration tests only. They TRUNCATE every table, so never point this at Supabase.
# Start it with `docker compose --profile test up -d test-db`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lead_intake_test
# Meta. Must match the "Verify Token" set in the Meta App Dashboard (min 16 chars).
META_VERIFY_TOKEN=change-me-to-a-long-random-string
# Meta App Secret (App Dashboard > Settings > Basic). Verifies X-Hub-Signature-256.
META_APP_SECRET=
# Long-lived Page access token (never expires) with leads_retrieval etc. See README "Meta setup".
META_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v25.0
# Tests only: a lead form used exclusively by automated tests (Meta allows 1 test lead per form).
META_TEST_FORM_ID=
# Scripts only: form used by `pnpm lead:create` for live demos (separate from the test form).
# Test leads can also be created at https://developers.facebook.com/tools/lead-ads-testing/
META_DEMO_FORM_ID=
